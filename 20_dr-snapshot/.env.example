# --- common
VAULT_IMAGE=hashicorp/vault:latest
VAULT_CONFIG=dc.hcl            # dc.hcl on DC VM, dr.hcl on DR VM

# --- DC only: used by scripts/snapshot-and-ship.sh
SNAPSHOT_TOKEN=                # token with policy "snapshot" (see README)
DR_SSH=ubuntu@18.138.224.190   # where to ship snapshots
DR_SNAPSHOT_DIR=/home/ubuntu/vault/dr-snapshot/snapshots
KEEP_LOCAL=24                  # how many snapshots to keep on DC

# --- DR only: used by scripts/failover.sh
RESTORE_TOKEN=                 # DR root token first time, then DC snapshot token (see README)
ROUTE53_ZONE_ID=               # optional: hosted zone id
DNS_NAME=vault.example.com     # optional: record clients use
DR_IP=18.138.224.190
